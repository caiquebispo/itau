{
    "name": "caiquebispo/itau",
    "description": "PHP SDK para as APIs do Itaú — Cobrança (Boletos), PIX, Pagamentos e Extratos com suporte multi-conta",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Caique Bispo",
            "email": "caiquebispodanet86@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "illuminate/support": "Para integração automática com Laravel (ServiceProvider + Facade)"
    },
    "autoload": {
        "psr-4": {
            "CaiqueBispo\\Itau\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CaiqueBispo\\Itau\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CaiqueBispo\\Itau\\Laravel\\ItauServiceProvider"
            ],
            "aliases": {
                "Itau": "CaiqueBispo\\Itau\\Laravel\\Facades\\Itau"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text"
    },
    "minimum-stability": "stable"
}
